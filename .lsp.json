{
  "nextflow": {
    "command": "${CLAUDE_PLUGIN_ROOT}/scripts/nextflow-language-server.sh",
    "extensionToLanguage": {
      ".nf": "nextflow",
      ".config": "nextflow-config"
    },
    "startupTimeout": 120000,
    "settings": {
      "nextflow": {
        "errorReportingMode": "WARNINGS",
        "files": {
          "exclude": [".git", ".nextflow", "work", ".nf-test", "node_modules", ".venv"]
        }
      }
    }
  }
}
